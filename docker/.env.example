# PostgreSQL credentials for the OMS database.
# Copy this file to .env and set a secure password.
POSTGRES_USER=oms
POSTGRES_PASSWORD=changeme
POSTGRES_DB=oms

# The WebSocket access token (#146). Compose won't start without one: the server refuses a client that doesn't offer it,
# and the app asks for it. Make one with: openssl rand -hex 32
OMS_WS_TOKEN=
# The pages a browser may connect from, comma-separated, such as http://oms.example.com:3000. Empty allows a page from
# anywhere, as long as it has the token.
OMS_ALLOWED_ORIGINS=
