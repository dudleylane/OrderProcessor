# PostgreSQL credentials for the OMS database. Copy this file to .env and set both passwords: compose refuses either
# left empty (#568). openssl rand -hex 32 makes one.
POSTGRES_USER=oms
# The superuser's, which makes the tables when a new volume starts
POSTGRES_PASSWORD=
POSTGRES_DB=oms
# The password of oms_server, the role the server connects as, which may read and write only the rows it mirrors (#568)
OMS_DB_SERVER_PASSWORD=

# The WebSocket access token (#146). Compose won't start without one: the server refuses a client that doesn't offer it,
# and the app asks for it. Make one with: openssl rand -hex 32
OMS_WS_TOKEN=
# The pages a browser may connect from, comma-separated, such as https://oms.example.com:3000. Empty allows a page from
# anywhere, as long as it has the token.
OMS_ALLOWED_ORIGINS=
# Strict-Transport-Security for the app (#226), such as max-age=31536000. Leave it empty until docker/certs holds a
# certificate browsers trust: a browser that has seen it refuses the site over any other.
OMS_HSTS=
# The host and port browsers reach the app at, such as oms.example.com:3000 or localhost:3000 (#564): plain HTTP is
# redirected there, rather than to whatever Host header a request carries. Compose won't start without it.
OMS_PUBLIC_HOST=
