# OMS Frontend Dockerfile
# Multi-stage: build with Node, serve with nginx

FROM node:24-slim AS builder
WORKDIR /app
COPY src/oms-frontend/package*.json ./
RUN npm ci
COPY src/oms-frontend/ .
# No VITE_WS_URL: the app connects to /ws on the page's own host and port, which nginx.conf passes to the server (#157)
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
# A template: the image's entrypoint renders it into conf.d, filling in the container's own DNS resolver (#158)
COPY docker/nginx.conf /etc/nginx/templates/default.conf.template
ENV NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1
# Not root (#158): nginx keeps its pid in /tmp, and the user nginx owns what nginx and its entrypoint write
RUN sed -i -e '/^user /d' -e 's,^pid .*,pid /tmp/nginx.pid;,' /etc/nginx/nginx.conf \
    && rm -f /etc/nginx/conf.d/default.conf \
    && chown -R nginx:nginx /var/cache/nginx /etc/nginx/conf.d
# nginx, the base image's own user, whom the frontend image check names (hadolint's DL3066)
# hadolint ignore=DL3066
USER nginx
EXPOSE 3000
# Healthy once nginx serves the UI (#158). docker-compose.yml repeats this, because podman's OCI images don't keep it.
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD ["curl", "-fs", "-o", "/dev/null", "--max-time", "2", "http://127.0.0.1:3000/"]
CMD ["nginx", "-g", "daemon off;"]
