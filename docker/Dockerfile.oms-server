# OrderProcessor Server Dockerfile
# Multi-stage: build with CentOS Stream 10, run with minimal image

# Whether the builder runs the test suite on the binaries it ships (#566). Off, as by default, the image is built as
# before; scripts/check-server-image.sh, which CI's image job runs, turns it on.
ARG TEST_IN_IMAGE=OFF

FROM quay.io/centos/centos:stream10 AS builder

# Packages aren't pinned to versions (hadolint's DL3041): the image takes CentOS Stream 10's current ones on every
# build, as the image check's --pull=newer intends (#135), so it gets their fixes. A pin would freeze them.
# The builder's RUNs keep dnf's cache, without the `dnf clean all` hadolint's DL3040 asks for, so that each later RUN
# uses the metadata this one fetched, EPEL's included, where each had fetched it again (#618): every fetch is another
# chance to meet a mirror mid-sync or a stale metalink (#291, #388). Only the runtime stage below ships, and it cleans.
# hadolint ignore=DL3040,DL3041
RUN dnf install -y epel-release 'dnf-command(config-manager)' \
    && dnf config-manager --set-enabled crb \
    && dnf install -y \
        cmake gcc-toolset-15-gcc-c++ git \
        tbb-devel spdlog-devel boost-devel lmdb-devel openssl-devel

# The engine needs GCC 15 (C++23's <flat_map>, among others), and the system gcc-c++ is GCC 14,
# so build with gcc-toolset-15, as CI and the pre-push hook do (#132).
ENV PATH=/opt/rh/gcc-toolset-15/root/usr/bin:$PATH \
    CXX=/opt/rh/gcc-toolset-15/root/usr/bin/g++

# How many compilers and LTRANS jobs the builds below run at once. Empty, as by default, they take every thread; CI's
# image and stack checks give a job's share of the host's threads (#738), since its runners run their jobs at once.
ARG JOBS=

# libpqxx, PostgreSQL's C++ client, for the Postgres write-behind (#151). Neither CentOS nor EPEL packages it, so it is
# built from its source at a release: the one CI's host has, from PostgreSQL's own repository (PGDG).
ARG LIBPQXX_REF=8.0.2
# With the metadata the first RUN fetched, as above (#618)
# hadolint ignore=DL3040,DL3041
RUN dnf install -y libpq-devel \
    && git clone --depth 1 --branch "$LIBPQXX_REF" https://github.com/jtv/libpqxx.git /tmp/libpqxx \
    && cmake -S /tmp/libpqxx -B /tmp/libpqxx/build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON \
        -DSKIP_BUILD_TEST=ON -DBUILD_DOC=OFF -DCMAKE_INSTALL_PREFIX=/usr/local \
    && cmake --build /tmp/libpqxx/build -j"${JOBS:-$(nproc)}" \
    && cmake --install /tmp/libpqxx/build \
    && rm -rf /tmp/libpqxx
ENV PKG_CONFIG_PATH=/usr/local/lib64/pkgconfig

WORKDIR /build
COPY CMakeLists.txt ./
COPY src/ src/
COPY app/ app/

# The binaries, without the tests. x86-64-v3, not -march=native (#170): native tied the image to the build machine's CPU.
# v3 is what CentOS Stream 10 itself is built for, so the image asks no more of a host's CPU than its base image does.
FROM builder AS build-OFF
ARG JOBS=
RUN cmake -B out -DCMAKE_BUILD_TYPE=Release -DMARCH=x86-64-v3 -DLTO_JOBS="${JOBS:-auto}" \
        -DBUILD_TESTS=OFF -DBUILD_BENCHMARKS=OFF -DBUILD_APP=ON -DBUILD_PG=ON \
    && cmake --build out -j"${JOBS:-$(nproc)}"

# The same binaries with the tests, in one tree, and the suite run on them before they're copied out (#566). CI's other
# jobs test a native Ninja build with the runner's packages, so without this a miscompile under the image's MARCH, its
# generator or that day's packages would ship. The whole context goes in, since the suite reads the docs, this file and
# the frontend's types. Left out: the repository's tooling tests (LABELS tooling), which test no binary and need git,
# jq, systemd or podman; and the Postgres cases, which skip without a database, the one skip the check accepts.
FROM builder AS build-ON
ARG JOBS=
COPY . .
RUN cmake -B out -DCMAKE_BUILD_TYPE=Release -DMARCH=x86-64-v3 -DLTO_JOBS="${JOBS:-auto}" \
        -DBUILD_TESTS=ON -DBUILD_BENCHMARKS=OFF -DBUILD_APP=ON -DBUILD_PG=ON \
    && cmake --build out -j"${JOBS:-$(nproc)}" \
    && { ctest --test-dir out --output-on-failure --timeout 300 -j"${JOBS:-$(nproc)}" -LE tooling > out/ctest.log 2>&1 \
        || { cat out/ctest.log; exit 1; }; } \
    && grep -E '^[0-9]+% tests passed|Total Test time' out/ctest.log \
    && scripts/ctest-skips.sh out/ctest.log 'PGWriteBehind|Postgres'

# build-OFF or build-ON above, a stage of this file rather than an image, so it has no tag to give (DL3006)
# hadolint ignore=DL3006
FROM build-${TEST_IN_IMAGE} AS built

# --- runtime stage ---
FROM quay.io/centos/centos:stream10

# Packages aren't pinned to versions (hadolint's DL3041): the image takes CentOS Stream 10's current ones on every
# build, as the image check's --pull=newer intends (#135), so it gets their fixes. A pin would freeze them. lmdb, LMDB's
# tools, gives mdb_copy, which copies the data directory while the server runs (#591: docker/README.md's "Backing up
# and checking the data"); el10 has it in CRB, which the builder enables for lmdb-devel, and this enables for it alone.
# hadolint ignore=DL3041
RUN dnf install -y epel-release \
    && dnf install -y tbb lmdb-libs spdlog libpq openssl-libs \
    && dnf install -y --enablerepo=crb lmdb \
    && dnf clean all

COPY --from=built /build/out/orderProcessorServer /usr/local/bin/
COPY --from=built /build/out/seedData /usr/local/bin/
# The server finds libpqxx through its RUNPATH, /usr/local/lib64; the loader entry covers a binary without one (#151)
COPY --from=builder /usr/local/lib64/libpqxx-*.so /usr/local/lib64/
RUN echo /usr/local/lib64 > /etc/ld.so.conf.d/usr-local-lib64.conf && ldconfig

# Not root (#158): the server and seedData run as oms, which owns /data. The directory is made before VOLUME declares it,
# so a new volume starts out owned by oms. oms is also in group 0 (#643), so it can read an identities file mounted with
# mode 0640: under rootless podman the host user's own group is group 0 in the container, and under Docker as root the
# file needs chgrp 0, as FX's TLS key does (#228).
RUN useradd --system --user-group --groups root --uid 10001 --home-dir /data --no-create-home oms \
    && mkdir -p /data \
    && chown oms:oms /data

EXPOSE 8080
VOLUME /data

# The log goes to standard output (#156), so `docker compose logs` shows it and the runtime rotates it. Without this it
# was /exchange.log in the container's own layer: outside the volume, lost on every rebuild, and never rotated.
ENV EXCHANGE_LOG=-

# oms, made above with uid 10001: the image check and docker-compose.yml name it (hadolint's DL3066)
# hadolint ignore=DL3066
USER oms

# Healthy once the server answers HTTP on its port (#158). Any answer will do: a plain GET gets the WebSocket server's
# 426 Upgrade Required (app/WsSession.cpp; this said 400 until #578). A TCP connect isn't enough, since a server that
# has stopped accepting (#202) still completes handshakes into its listen backlog. The server listens only after
# restoring /data, so a large directory may need a longer start period, and a server started on another port needs its
# own check. docker-compose.yml repeats this check, because podman builds OCI images by default, and they don't keep it.
HEALTHCHECK --interval=10s --timeout=3s --start-period=120s --retries=3 \
    CMD ["curl", "-s", "-o", "/dev/null", "--max-time", "2", "http://127.0.0.1:8080/"]

ENTRYPOINT ["orderProcessorServer"]
CMD ["--port", "8080", "--data-dir", "/data"]
