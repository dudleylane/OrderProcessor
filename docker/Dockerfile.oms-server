# OrderProcessor Server Dockerfile
# Multi-stage: build with CentOS Stream 10, run with minimal image

FROM quay.io/centos/centos:stream10 AS builder

# Packages aren't pinned to versions (hadolint's DL3041): the image takes CentOS Stream 10's current ones on every
# build, as the image check's --pull=newer intends (#135), so it gets their fixes. A pin would freeze them.
# hadolint ignore=DL3041
RUN dnf install -y epel-release 'dnf-command(config-manager)' \
    && dnf config-manager --set-enabled crb \
    && dnf install -y \
        cmake gcc-toolset-15-gcc-c++ git \
        tbb-devel spdlog-devel boost-devel lmdb-devel numactl-devel \
    && dnf clean all

# The engine needs GCC 15 (C++23's <flat_map>, among others), and the system gcc-c++ is GCC 14,
# so build with gcc-toolset-15, as CI and the pre-push hook do (#132).
ENV PATH=/opt/rh/gcc-toolset-15/root/usr/bin:$PATH \
    CXX=/opt/rh/gcc-toolset-15/root/usr/bin/g++

# The FIX gateway builds against QuickFIX 22 from the maintained fork (CMakeLists.txt asks for major
# 22), at QUICKFIX_REF. CI's FIX-on jobs read this ref and build it with the same script, so they test
# what this image ships (#178): raise it as docs/QUICKFIX_DEPENDENCY.md describes.
ARG QUICKFIX_REF=v22.1.0
COPY scripts/build-quickfix.sh /tmp/
# openssl-devel isn't pinned either (DL3041), for the same reason as the packages above
# hadolint ignore=DL3041
RUN dnf install -y openssl-devel && dnf clean all \
    && /tmp/build-quickfix.sh "$QUICKFIX_REF" /usr/local \
    && rm /tmp/build-quickfix.sh

WORKDIR /build
COPY CMakeLists.txt ./
COPY src/ src/
COPY app/ app/

COPY config/ config/

# x86-64-v3, not -march=native (#170): native tied the image to the build machine's CPU. v3 is what CentOS Stream 10
# itself is built for, so the image asks no more of a host's CPU than its base image does.
RUN cmake -B out -DCMAKE_BUILD_TYPE=Release -DMARCH=x86-64-v3 \
        -DBUILD_TESTS=OFF -DBUILD_BENCHMARKS=OFF -DBUILD_APP=ON -DBUILD_FIX=ON \
    && cmake --build out -j"$(nproc)"

# --- runtime stage ---
FROM quay.io/centos/centos:stream10

# Packages aren't pinned to versions (hadolint's DL3041): the image takes CentOS Stream 10's current ones on every
# build, as the image check's --pull=newer intends (#135), so it gets their fixes. A pin would freeze them.
# hadolint ignore=DL3041
RUN dnf install -y epel-release \
    && dnf install -y tbb lmdb-libs spdlog numactl-libs \
    && dnf clean all

COPY --from=builder /build/out/orderProcessorServer /usr/local/bin/
COPY --from=builder /build/out/seedData /usr/local/bin/
COPY --from=builder /usr/local/lib/libquickfix.so* /usr/local/lib/
COPY --from=builder /build/config/ /etc/orderprocessor/

# The server finds libquickfix through its RUNPATH, /usr/local/lib, which CMake gives a build-tree binary
# linked to a library outside the system directories. This loader entry isn't needed for it; it covers a
# binary without that RUNPATH, such as one installed with `cmake --install` (#132, corrected in #135).
RUN echo /usr/local/lib > /etc/ld.so.conf.d/usr-local.conf && ldconfig

# Not root (#158): the server and seedData run as oms, which owns /data. The directory is made before VOLUME declares it,
# so a new volume starts out owned by oms.
RUN useradd --system --user-group --uid 10001 --home-dir /data --no-create-home oms \
    && mkdir -p /data \
    && chown oms:oms /data

EXPOSE 8080 5001
VOLUME /data

# The log goes to standard output (#156), so `docker compose logs` shows it and the runtime rotates it. Without this it
# was /exchange.log in the container's own layer: outside the volume, lost on every rebuild, and never rotated.
ENV EXCHANGE_LOG=-

# oms, made above with uid 10001: the image check and docker-compose.yml name it (hadolint's DL3066)
# hadolint ignore=DL3066
USER oms

# Healthy once the server answers HTTP on its port (#158). Any answer will do: a plain GET gets the WebSocket server's
# 400. A TCP connect isn't enough, since a server that has stopped accepting (#202) still completes handshakes into its
# listen backlog. The server listens only after restoring /data, so a large directory may need a longer start period, and
# a server started on another port needs its own check. docker-compose.yml repeats this check, because podman builds
# OCI images by default, and they don't keep it.
HEALTHCHECK --interval=10s --timeout=3s --start-period=120s --retries=3 \
    CMD ["curl", "-s", "-o", "/dev/null", "--max-time", "2", "http://127.0.0.1:8080/"]

# FIX needs the deployment's credentials file (#147), which the image doesn't hold: mount it at this path, readable by oms.
# It holds only password hashes, which `orderProcessorServer --hash-fix-password` makes. Without it the server exits 1,
# saying it can't read the file.
ENTRYPOINT ["orderProcessorServer"]
CMD ["--port", "8080", "--data-dir", "/data", "--fix-cfg", "/etc/orderprocessor/fix.cfg", \
     "--fix-credentials", "/etc/orderprocessor/fix-credentials"]
