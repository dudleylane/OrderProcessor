#!/usr/bin/env bash
# pre-push: the local gate from the Decision-Making Policy.
#
# Runs the same three checks the CI workflows run, against the existing
# Release build directory, and refuses the push if any of them fails:
#   1. cmake --build            (build-test.yml: Build)
#   2. ctest -j1                (build-test.yml: Test; -j1 because
#                                LMDBStorageTest cases share a directory)
#   3. clang-format --dry-run   (format.yml)
# Sanitizer and benchmark runs are not included: the policy lists them as
# per-change extras, not the always-on gate.
#
# Enable once per clone:        git config core.hooksPath scripts/hooks
# Bypass, visibly and on purpose: git push --no-verify, and record it with a
# 'Deviation:' trailer on the commit.
#
# Environment:
#   BUILD_DIR     Release build directory (default: <repo>/build). Configured
#                 on first use if it does not exist.
#   CLANG_FORMAT  clang-format binary (default: clang-format-22, the version
#                 format.yml pins, so the hook and CI check the same thing).
#
# Delete-only pushes (every local SHA zero) are exempt: nothing new is
# published by them.

set -euo pipefail

ZERO=0000000000000000000000000000000000000000
updates=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    if [[ "$local_sha" != "$ZERO" ]]; then
        updates=$((updates + 1))
    fi
done
if (( updates == 0 )); then
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
BUILD_DIR="${BUILD_DIR:-$ROOT/build}"
CLANG_FORMAT="${CLANG_FORMAT:-clang-format-22}"

# Same toolchain activation as the CI workflows.
TOOLSET=/opt/rh/gcc-toolset-15/root/usr
if [[ -d "$TOOLSET" ]]; then
    export PATH="$TOOLSET/bin:$PATH"
    export LD_LIBRARY_PATH="$TOOLSET/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    export CC="$TOOLSET/bin/gcc" CXX="$TOOLSET/bin/g++"
fi

refuse() {
    echo >&2
    echo "pre-push: REFUSED: $1" >&2
    echo "pre-push: fix it and push again, or push with --no-verify and add a" >&2
    echo "pre-push: 'Deviation:' trailer to the commit (Decision-Making Policy)." >&2
    exit 1
}

step() {
    echo
    echo "=== pre-push: $1 ==="
}

# 0. Preflight: fail closed on missing tools before spending minutes building.
missing=()
for tool in cmake ctest "$CLANG_FORMAT"; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        missing+=("$tool")
    fi
done
if (( ${#missing[@]} > 0 )); then
    refuse "missing tool(s): ${missing[*]} (clang-format: sudo dnf install clang-tools-extra)"
fi

# 1. Configure on first use, then build. CI tests a Release build; insist on one.
step "build ($BUILD_DIR)"
if [[ ! -f "$BUILD_DIR/CMakeCache.txt" ]]; then
    cmake -S "$ROOT" -B "$BUILD_DIR" -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTS=ON -DBUILD_BENCHMARKS=ON -DBUILD_APP=ON -DBUILD_PG=OFF \
        || refuse "configure failed"
fi
if ! grep -q '^CMAKE_BUILD_TYPE:STRING=Release$' "$BUILD_DIR/CMakeCache.txt"; then
    refuse "$BUILD_DIR is not a Release build; CI tests Release. Point BUILD_DIR at one."
fi
# ctest exits 0 when it finds no tests, so a BUILD_TESTS=OFF directory would
# pass the gate vacuously. Refuse it here, before the slow build step.
if ! ctest --test-dir "$BUILD_DIR" -N 2>/dev/null | grep -qE '^Total Tests: [1-9]'; then
    refuse "$BUILD_DIR registers no tests (BUILD_TESTS=OFF?); ctest would pass vacuously"
fi
cmake --build "$BUILD_DIR" -j"$(nproc)" || refuse "build failed"

# 2. Tests, serial, as in CI.
step "ctest -j1"
ctest --test-dir "$BUILD_DIR" --output-on-failure -j1 || refuse "tests failed"

# 3. Format check, identical to format.yml.
step "$("$CLANG_FORMAT" --version) --dry-run"
( cd "$ROOT" && find src test app bench \( -name '*.h' -o -name '*.cpp' \) -print0 \
    | xargs -0 "$CLANG_FORMAT" --dry-run -Werror ) || refuse "format check failed"

echo
echo "=== pre-push: all gates passed ==="
